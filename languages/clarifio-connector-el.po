msgid "Connects WooCommerce to Clarif.io to calculate net profit."
msgstr "Συνδέει το WooCommerce με το Clarif.io για τον υπολογισμό καθαρού κέρδους."

msgid "<strong>Clarif.io Connector:</strong> The plugin requires <strong>WooCommerce</strong> to be installed and activated."
msgstr "<strong>Clarif.io Connector:</strong> Για να λειτουργήσει το plugin, απαιτείται η εγκατάσταση και ενεργοποίηση του <strong>WooCommerce</strong>."

#, php-format
msgid "<strong>Clarif.io:</strong> Data sync has stopped because your subscription has expired. <a href=\"%s\" target=\"_blank\">Go to billing</a> to renew it."
msgstr "<strong>Clarif.io:</strong> Ο συγχρονισμός δεδομένων έχει διακοπεί επειδή η συνδρομή σας έχει λήξει. <a href=\"%s\" target=\"_blank\">Μεταβείτε στο ταμείο</a> για να την ανανεώσετε."

msgid "Clarif.io settings were saved successfully."
msgstr "Οι ρυθμίσεις του Clarif.io αποθηκεύτηκαν με επιτυχία."

msgid "Unknown error"
msgstr "Άγνωστο σφάλμα"

msgid "Success:"
msgstr "Επιτυχία:"

msgid "Error:"
msgstr "Σφάλμα:"

msgid "Could not reach the server:"
msgstr "Αποτυχία επικοινωνίας με τον server:"

msgid "Start catalog sync"
msgstr "Έναρξη Συγχρονισμού Καταλόγου"

msgid "Sync in progress..."
msgstr "Συγχρονισμός σε εξέλιξη..."

msgid "Preparing data..."
msgstr "Προετοιμασία δεδομένων..."

msgid "No orders:"
msgstr "Καμία παραγγελία:"

msgid "No orders found to sync."
msgstr "Δεν βρέθηκαν παραγγελίες προς συγχρονισμό."

#, php-format
msgid "Sending orders %1$s–%2$s of %3$s..."
msgstr "Αποστολή παραγγελιών %1$s–%2$s από %3$s..."

msgid "Completed"
msgstr "Ολοκληρώθηκε"

#, php-format
msgid "%1$s orders were synced to Clarif.io."
msgstr "Συγχρονίστηκαν %1$s παραγγελίες στο Clarif.io."

#, php-format
msgid "Stopped after %1$s of %2$s orders:"
msgstr "Διακοπή μετά από %1$s από %2$s παραγγελίες:"

msgid "Your daily financial compass for e-commerce."
msgstr "Η καθημερινή σας οικονομική πυξίδα για το e-commerce."

msgid "Open app"
msgstr "Άνοιγμα Εφαρμογής"

msgid "Overview"
msgstr "Επισκόπηση"

msgid "Products & Costs"
msgstr "Προϊόντα & Κόστη"

msgid "Order History"
msgstr "Ιστορικό Παραγγελιών"

msgid "Connection & Settings"
msgstr "Σύνδεση & Ρυθμίσεις"

msgid "System Status"
msgstr "Κατάσταση Συστήματος"

msgid "Financial clarity for your e-shop."
msgstr "Οικονομική διαύγεια για το e-shop σας."

msgid "Revenue is vanity, profit is sanity. Clarif.io connects to your WooCommerce store and calculates your <strong>real Net Profit</strong> in real time, automatically subtracting purchase costs (COGS), shipping and payment fees."
msgstr "Ο τζίρος είναι ματαιοδοξία, το κέρδος είναι λογική. Το Clarif.io συνδέεται στο WooCommerce σας και υπολογίζει σε πραγματικό χρόνο το <strong>Πραγματικό Καθαρό Κέρδος (Net Profit)</strong>, αφαιρώντας αυτόματα τα κόστη αγοράς (COGS), τα μεταφορικά και τις προμήθειες των τραπεζών."

msgid "Start your free trial"
msgstr "Ξεκινήστε τη δωρεάν δοκιμή σας"

msgid "Find out which products leave you real profit and which ones \"eat\" your budget. No commitment, no credit card."
msgstr "Ανακαλύψτε ποια προϊόντα σας αφήνουν πραγματικό κέρδος και ποια \"τρώνε\" το budget σας. Χωρίς δέσμευση, χωρίς πιστωτική κάρτα."

msgid "Create account"
msgstr "Δημιουργία Λογαριασμού"

msgid "Connect an existing account"
msgstr "Σύνδεση υπάρχοντος λογαριασμού"

msgid "If you have already registered, paste your store's unique API Key below. You will find it under \"Stores\" in the Clarif.io app."
msgstr "Εάν έχετε ήδη εγγραφεί, επικολλήστε το μοναδικό API Key του καταστήματός σας παρακάτω. Θα το βρείτε στην επιλογή \"Καταστήματα\" στο Clarif.io App."

msgid "e.g. cl_live_8f7d6a5..."
msgstr "π.χ. cl_live_8f7d6a5..."

msgid "Connect securely"
msgstr "Ασφαλής Σύνδεση"

msgid "<strong>Network error:</strong> Could not reach the Clarif.io servers. Please check your connection."
msgstr "<strong>Σφάλμα Δικτύου:</strong> Αδυναμία επικοινωνίας με τους διακομιστές του Clarif.io. Παρακαλώ ελέγξτε τη σύνδεσή σας."

msgid "Your subscription has expired"
msgstr "Η συνδρομή σας έληξε"

msgid "Order sync and statistics have stopped. Please renew your plan to keep tracking your profits."
msgstr "Ο συγχρονισμός των παραγγελιών και η προβολή στατιστικών έχουν διακοπεί. Παρακαλώ ανανεώστε το πακέτο σας για να συνεχίσετε να παρακολουθείτε τα κέρδη σας."

msgid "Renew subscription"
msgstr "Ανανέωση Συνδρομής"

msgid "Secure connection active"
msgstr "Ασφαλής Σύνδεση Ενεργή"

#, php-format
msgid "The e-shop <strong>%s</strong> is syncing in real time."
msgstr "Το e-shop <strong>%s</strong> συγχρονίζεται σε πραγματικό χρόνο."

msgid "This month's summary"
msgstr "Σύνοψη Τρέχοντος Μήνα"

msgid "Updated in real time"
msgstr "Ανανέωση σε πραγματικό χρόνο"

msgid "Gross revenue"
msgstr "Μικτός Τζίρος"

msgid "Total revenue before deductions"
msgstr "Συνολικά έσοδα προ κρατήσεων"

msgid "Net profit"
msgstr "Καθαρό Κέρδος"

msgid "The money that stays in the business"
msgstr "Τα χρήματα που μένουν στην επιχείρηση"

msgid "Average margin"
msgstr "Μέσο Περιθώριο (Margin)"

msgid "Store profitability health"
msgstr "Υγεία κερδοφορίας καταστήματος"

msgid "For deeper analysis, customer LTV and per-product reports, go to the full app."
msgstr "Για βαθύτερη ανάλυση, LTV πελατών, και αναφορές ανά προϊόν, μεταβείτε στην πλήρη εφαρμογή."

msgid "Go to the web app &rarr;"
msgstr "Μετάβαση στο Web App &rarr;"

msgid "<strong>Authentication error:</strong> The API Key appears to be invalid or has been revoked. Please check your settings."
msgstr "<strong>Σφάλμα Αυθεντικοποίησης:</strong> Το API Key φαίνεται να είναι άκυρο ή έχει ανακληθεί. Ελέγξτε τις ρυθμίσεις σας."

msgid "Connection & Algorithm Settings"
msgstr "Ρυθμίσεις Σύνδεσης & Αλγορίθμου"

msgid "Manage how your store communicates with the data analytics platform."
msgstr "Διαχειριστείτε την επικοινωνία του καταστήματός σας με την πλατφόρμα ανάλυσης δεδομένων."

msgid "Store API Key"
msgstr "API Key Καταστήματος"

msgid "The secret key that secures the encrypted transfer of your data."
msgstr "Το μυστικό κλειδί που εξασφαλίζει την κρυπτογραφημένη μεταφορά των δεδομένων σας."

msgid "Default purchase cost (COGS)"
msgstr "Προεπιλεγμένο Κόστος Αγοράς (COGS)"

msgid "% of the retail price"
msgstr "% της λιανικής τιμής"

msgid "If a product has no explicitly filled \"Cost\" field, the Clarif.io algorithm will use this percentage as a safety net."
msgstr "Εάν ένα προϊόν δεν έχει ρητά συμπληρωμένο πεδίο \"Κόστος\", ο αλγόριθμος του Clarif.io θα χρησιμοποιήσει αυτό το ποσοστό ως δίχτυ ασφαλείας."

msgid "Example: if set to 60% and you sell something for €100, the system will assume you bought it for €60."
msgstr "Παράδειγμα: Αν οριστεί στο 60% και πουλήσετε κάτι 100€, το σύστημα θα θεωρήσει ότι το αγοράσατε 60€."

msgid "Save changes"
msgstr "Αποθήκευση Αλλαγών"

msgid "Product Database"
msgstr "Βάση Δεδομένων Προϊόντων"

msgid "The foundation of accurate financial calculations. This function collects all your active products, SKUs and costs, building the unified catalog in Clarif.io."
msgstr "Ο θεμέλιος λίθος των σωστών οικονομικών υπολογισμών. Η λειτουργία αυτή συλλέγει όλα τα ενεργά σας προϊόντα, τα SKUs και τα κόστη τους, δημιουργώντας το ενιαίο ευρετήριο (Catalog) στο Clarif.io."

msgid "When should you use this function?"
msgstr "Πότε να χρησιμοποιήσετε αυτή τη λειτουργία;"

msgid "During the plugin's <strong>initial installation</strong>."
msgstr "Κατά την <strong>αρχική εγκατάσταση</strong> του plugin."

msgid "If you made a <strong>bulk change of purchase prices (costs)</strong> in WooCommerce (e.g. via a CSV file or an ERP)."
msgstr "Αν κάνατε <strong>μαζική αλλαγή τιμών αγοράς (κοστών)</strong> στο WooCommerce (π.χ. μέσω κάποιου αρχείου CSV ή ERP)."

msgid "*Note: You do not need to press this every day. When you edit or create a product, the plugin updates Clarif.io automatically in the background."
msgstr "*Σημείωση: Δεν χρειάζεται να το πατάτε καθημερινά. Όταν επεξεργάζεστε/δημιουργείτε ένα προϊόν, το plugin ενημερώνει αυτόματα το Clarif.io στο παρασκήνιο."

msgid "Order History Analysis"
msgstr "Ιστορικό Ανάλυσης Παραγγελιών"

msgid "Discover the hidden value of your older data. Bulk sync sends your sales history to Clarif.io, allowing the algorithm to build the historical charts and calculate <strong>Customer Lifetime Value (LTV)</strong>."
msgstr "Ανακαλύψτε την κρυμμένη αξία των παλαιών σας δεδομένων. Ο μαζικός συγχρονισμός αποστέλλει το ιστορικό πωλήσεών σας στο Clarif.io, επιτρέποντας στον αλγόριθμο να κατασκευάσει τα ιστορικά γραφήματα και να υπολογίσει την <strong>Αξία Ζωής Πελάτη (LTV)</strong>."

msgid "<strong>Infrastructure note:</strong> The process is designed to be \"invisible\" to your server. Orders are grouped and sent in batches (of 50), ensuring no slowdown of your e-shop during the sync."
msgstr "<strong>Πληροφορία Υποδομής:</strong> Η διαδικασία έχει σχεδιαστεί ώστε να είναι \"αόρατη\" για τον server σας. Οι παραγγελίες ομαδοποιούνται και αποστέλλονται τμηματικά (ανά 50), εξασφαλίζοντας μηδενική πτώση στην ταχύτητα του e-shop σας κατά τη διάρκεια του συγχρονισμού."

msgid "Start history analysis"
msgstr "Έναρξη Ανάλυσης Ιστορικού"

msgid "Event Log"
msgstr "Αρχείο Καταγραφής Συμβάντων (Logs)"

msgid "The last 50 entries are kept"
msgstr "Διατηρούνται οι τελευταίες 50 εγγραφές"

msgid "Use this screen to troubleshoot, or send a screenshot to Clarif.io support if you run into a problem."
msgstr "Χρησιμοποιήστε αυτή την οθόνη για έλεγχο ορθής λειτουργίας (troubleshooting) ή στείλτε ένα στιγμιότυπο στην υποστήριξη του Clarif.io σε περίπτωση προβλήματος."

msgid "Event"
msgstr "Συμβάν (Event)"

msgid "Status"
msgstr "Κατάσταση"

msgid "Details (request / response)"
msgstr "Λεπτομέρειες (αίτημα / απάντηση)"

msgid "No communication events have been logged yet."
msgstr "Δεν έχουν καταγραφεί ακόμη ενέργειες επικοινωνίας."

msgid "No response"
msgstr "Χωρίς απάντηση"

msgid "View"
msgstr "Προβολή"

msgid "Request"
msgstr "Αίτημα"

msgid "Response"
msgstr "Απάντηση"

msgid "(no response)"
msgstr "(καμία απάντηση)"

msgid "Could not reach Clarif.io"
msgstr "Αδυναμία επικοινωνίας με το Clarif.io"

msgid "Origin mismatch: this API key does not belong to this domain."
msgstr "Ασυμφωνία domain: το API Key δεν ανήκει σε αυτό το domain."

msgid "Your subscription has expired. Please upgrade your plan."
msgstr "Η συνδρομή σας έχει λήξει. Παρακαλώ αναβαθμίστε το πακέτο σας."

msgid "Your 14-day trial has ended."
msgstr "Η δοκιμαστική σας περίοδος (14 ημέρες) έχει λήξει."

msgid "Your trial limit (500 orders) has been reached."
msgstr "Το δοκιμαστικό σας όριο (500 παραγγελίες) έχει εξαντληθεί."

msgid "Your trial limit would be exceeded. Please upgrade."
msgstr "Το δοκιμαστικό σας όριο θα εξαντληθεί. Παρακαλώ αναβαθμίστε."

msgid "You have reached your monthly order limit."
msgstr "Έχετε φτάσει το μηνιαίο όριο παραγγελιών."

msgid "Store not found."
msgstr "Το κατάστημα δεν βρέθηκε."

msgid "An unexpected error occurred. Please try again."
msgstr "Παρουσιάστηκε ένα απρόσμενο σφάλμα. Παρακαλώ δοκιμάστε ξανά."

#, php-format
msgid "You have reached the limit of %d products. Please upgrade your plan."
msgstr "Έχετε φτάσει το όριο των %d προϊόντων. Αναβαθμίστε το πακέτο σας."

#, php-format
msgid "Sync failed. You exceed the limit of %d products."
msgstr "Αδυναμία συγχρονισμού. Υπερβαίνετε το όριο των %d προϊόντων."

msgid "Clarif.io Cost (€)"
msgstr "Κόστος Clarif.io (€)"

msgid "Enter the purchase cost for an accurate profit calculation."
msgstr "Εισάγετε το κόστος αγοράς για ακριβή υπολογισμό κέρδους."

msgid "Unauthorized access."
msgstr "Μη εξουσιοδοτημένη πρόσβαση."

msgid "No API Key has been set."
msgstr "Δεν έχει οριστεί API Key."

msgid "No products found to sync."
msgstr "Δεν βρέθηκαν προϊόντα για συγχρονισμό."

msgid "No orders were provided for processing."
msgstr "Δεν δόθηκαν παραγγελίες προς επεξεργασία."

#, php-format
msgid "Successfully sent %d products!"
msgstr "Στάλθηκαν επιτυχώς %d προϊόντα!"

#, php-format
msgid "The API returned code %1$s: %2$s"
msgstr "Το API επέστρεψε κωδικό %1$s: %2$s"

